# ============================================================================
# .dockerignore - Files to exclude from Docker build
# ============================================================================

# Node modules
node_modules/
npm-debug.log
yarn-error.log

# Environment files
.env
.env.local
.env.development
.env.test
.env.production

# Git
.git/
.gitignore

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage/
.nyc_output/

# Build artifacts
build/
dist/
*.tgz

# Temporary files
tmp/
temp/

# Documentation
*.md
!README.md

# Ganache data (will be in volume)
ganache-data-dev/
ganache-data/

# Uploads (will be in volume)
uploads/

# Docker files
Dockerfile
docker-compose*.yml
.dockerignore
