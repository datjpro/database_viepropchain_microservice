# ============================================================================
# Environment Variables for Docker Deployment
# ============================================================================
# Copy this file to .env and fill in your actual values
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=viepropchain2025
MONGODB_URI=mongodb://admin:viepropchain2025@mongodb:27017/viepropchain?authSource=admin

# ============================================================================
# JWT & SESSION SECRETS
# ============================================================================
JWT_SECRET=viepropchain-super-secret-jwt-key-2025-change-in-production
SESSION_SECRET=viepropchain-session-secret-2025-change-in-production

# ============================================================================
# BLOCKCHAIN CONFIGURATION
# ============================================================================
# Ganache default accounts (from mnemonic)
# Account 0: 0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
# Private Key: 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

OPERATOR_WALLET_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
OPERATOR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
GANACHE_URL=http://ganache:8545
NETWORK_ID=1337

# ============================================================================
# GOOGLE OAUTH (Gmail Login)
# ============================================================================
# Get from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ============================================================================
# IPFS / PINATA CONFIGURATION
# ============================================================================
# Get from: https://www.pinata.cloud/
PINATA_API_KEY=your-pinata-api-key
PINATA_SECRET_KEY=your-pinata-secret-key

# ============================================================================
# EMAIL CONFIGURATION (Optional)
# ============================================================================
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-specific-password

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================
REACT_APP_API_URL=http://localhost:4000/api
REACT_APP_WS_URL=ws://localhost:4000
FRONTEND_URL=http://localhost:3000

# ============================================================================
# NODE ENVIRONMENT
# ============================================================================
NODE_ENV=production

# ============================================================================
# SERVICE PORTS (Internal Docker Network)
# ============================================================================
API_GATEWAY_PORT=4000
IPFS_SERVICE_PORT=4002
ADMIN_SERVICE_PORT=4003
BLOCKCHAIN_SERVICE_PORT=4004
INDEXER_SERVICE_PORT=4005
USER_SERVICE_PORT=4006
KYC_SERVICE_PORT=4007
MESSAGE_SERVICE_PORT=4008
MARKETPLACE_SERVICE_PORT=4009
AUTH_SERVICE_PORT=4010

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
