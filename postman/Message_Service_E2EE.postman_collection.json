              "raw": "{\n  \"recipient_id\": \"{{recipient_user_id}}\",\n  \"content\": \"I'm interested in buying your property listed for 50 ETH\",\n  \"chat_type\": \"marketplace\",\n  \"metadata\": {\n    \"listing_id\": \"{{listing_id}}\",\n    \"property_id\": \"{{property_id}}\",\n    \"offer_amount\": \"45000000000000000000\"\n  }\n}"
            },
            "url": {
